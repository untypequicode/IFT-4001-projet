% ============================================================================
% DONNÉES GÉNÉRÉES POUR MODEL e-v1 (DÉTAILLÉ)
% Modèle basé sur des PÉRIODES discrètes.
% ============================================================================

% --- Temps et Unités ---
% J: Nombre de jours de simulation
% PJ: Nombre de périodes par jour
J = 1; PJ = 144;
% PSetup: Temps de setup entre opérations (en périodes)
% PVoie: Temps de sécurité entre trains sur une voie (en périodes)
PSetup = 1; PVoie = 4;
% EtageMax: Nombre maximum d'étages (caténaires) possibles
EtageMax = 3;

% --- Voies (Infrastructures) ---
% VTNb: Nombre de TYPES de voies
VTNb = 2;
% VNbT: Nombre de voies pour chaque type
VNbT = [1, 2];
% VEtage: Étage (équipement caténaire) de chaque voie physique
VEtage = [3, 2, 2];

% --- Équipements ---
% ENb: Nombre de types d'équipements
ENb = 2;
% ECapacite: Capacité simultanée (combien d'ops en // sur cet équipement)
ECapacite = [4, 2];
% EQuantite: Nombre total d'unités de cet équipement
EQuantite = [3, 3];
% VEDisponible: Matrice [Voie, Equipement] -> Est-ce dispo sur cette voie ?
VEDisponible = [|
  true, true |
  true, true |
  true, true
|];

% --- Techniciens ---
% STNb: Nombre de types de techniciens (spécialités)
STNb = 2;
% SNbT: Nombre de techniciens par spécialité
SNbT = [3, 7];
% STTempsMin/Max: Temps de travail min/max journalier (en périodes)
STTempsMin = [24, 24];
STTempsMax = [36, 40];

% --- Trains ---
% TTNb: Nombre de TYPES de trains
TTNb = 1;
% TNbT: Nombre de trains par type
TNbT = [2];
% TEtage: Étage requis par type de train
TEtage = [1];

% --- Gares et Trajets ---
% GNb: Nombre de gares périphériques
GNb = 3;
% GTemps: Temps de trajet Gare <-> Centre (en périodes)
GTemps = [6, 5, 3];

% --- Intervalles de Disponibilité (Input) ---
% Liste plate des intervalles où les trains sont présents au centre.
% Gare=0 signifie 'Au Centre'.
% InputNbIntervallesParTrain: Combien d'intervalles par train [1..TNb]
InputNbIntervallesParTrain = [2, 3];
% InputIntervallesDebut: Période de début de chaque intervalle
InputIntervallesDebut = [47, 113, 31, 82, 120];
% InputIntervallesFin: Période de fin de chaque intervalle
InputIntervallesFin = [88, 131, 64, 109, 144];
% InputIntervallesGareDebut: Gare de provenance (0=Centre)
InputIntervallesGareDebut = [0, 0, 0, 0, 0];
% InputIntervallesGareFin: Gare de destination (0=Centre)
InputIntervallesGareFin = [0, 0, 0, 0, 0];

% --- Opérations ---
% OTNb: Nombre de TYPES d'opérations
OTNb = 2;
% OEquipement: Matrice [OpType, EquipType] -> Besoin équipement ?
OEquipement = [|
  true, false |
  false, true
|];
% OTemps: Matrice [OpType, Etage] -> Durée (périodes)
OTemps = [|
  3, 4, 4 |
  3, 2, 1
|];
% ODependance: Matrice [OpA, OpB] -> OpA dépend de OpB ?
ODependance = [|
  false, false |
  false, false
|];
% OShift: Type de technicien requis pour l'opération
OShift = [2, 2];
% OVoie: Matrice [OpType, VoieType] -> Compatible ?
OVoie = [|
  false, false |
  false, true
|];

% --- Maintenances ---
% MTNb: Nombre de TYPES de maintenances
MTNb = 2;
% MOperation: Matrice [MaintType, OpType] -> L'opération est-elle requise ?
MOperation = [|
  true, false |
  false, true
|];
% MTPeriode: Périodicité [TrainType, MaintType] (périodes, 0=Urgente, infinity=Jamais)
MTPeriode = [|
  2016, 1008
|];
% MDerniereFois: Date dernière maintenance [TrainInstance, MaintType] (négatif = passé)
MDerniereFois = [|
  -2776, -431 |
  -4117, -3617
|];