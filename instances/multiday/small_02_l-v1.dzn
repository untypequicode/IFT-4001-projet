% ============================================================================
% DONNÉES GÉNÉRÉES POUR MODEL l-v1 (RCPSP)
% Modèle continu (minutes) avec Sets explicites.
% ============================================================================

% H: Horizon total de planification en minutes
H = 7200;

% --- Ensembles (Sets) : Indices 1..N ---
TRAIN = 1..3;
TRACK = 1..4;
TECH = 1..3;
EQUIP = 1..2;
MAINT = 1..3;
OP = 1..3;

% --- Paramètres Trains ---
% arrival: Heure d'arrivée au centre (minutes)
arrival = [910, 420, 1120];
% departure: Heure de départ du centre (minutes)
departure = [7180, 7200, 7200];
% train_complexity: Basé sur le nombre d'étages (caténaire)
train_complexity = [2, 2, 2];

% --- Paramètres Maintenances ---
maint_train = [1, 2, 3];
periodicity = [129600, 129600, 129600];
priority = [2, 2, 2];
last_done = [-1150, -28820, -22260];
due_date = [128450, 100780, 107340];

% --- Paramètres Opérations ---
op_maint = [1, 2, 3];
duration = [20, 20, 20];
required_track_type = [1, 1, 1];
predecessor = [0, 0, 0];

% --- Ressources Humaines ---
% nb_total: Nombre de techniciens par type
nb_total = [8, 6, 8];
% min/max_time: Temps de travail en minutes
min_time = [280, 240, 240];
max_time = [320, 360, 400];

% --- Ressources Matérielles ---
quantity = [2, 2];
simultaneous_capacity = [4, 2];

% --- Matrices de Besoins (Relations N-N) ---
% tech_required: [Op, TechType] -> 1 si requis, 0 sinon
tech_required = [|
  0, 1, 0 |
  0, 1, 0 |
  0, 1, 0 |
|];
% equip_required: [Op, EquipType] -> 1 si requis, 0 sinon
equip_required = [|
  0, 1 |
  0, 1 |
  0, 1 |
|];
% equip_available_on_track: [Voie, EquipType] -> Dispo ?
equip_available_on_track = [|
  false, false |
  true, false |
  true, true |
  false, true |
|];

% --- Setup ---
setup_time_between_trains = 20;
setup_time_between_ops = 10;