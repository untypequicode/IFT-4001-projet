% === Maintenances & Opérations ===
OEquipement = [| true, false    % Inspection: Moteur oui, Pantographe non
              | true, true      % Revision: Moteur et Pantographe
              | true, false |]; % Vidange: Moteur seulement

OTemps = [| 60, 90              % Temps par plexité (Simple, Duplex)
         | 120, 180
         | 45, 60 |];

ODependance = [| false, false, false    % Inspection ne dépend de rien
              | true, false, false      % Revision dépend d'Inspection
              | false, false, false |]; % Vidange indépendante

OShift = [1, 2, 1];             % Techniciens par opération
OVType = [Exterieur, Atelier, Atelier];

MOperation = [| true, false, true       % M1: Inspection + Vidange
             | true, true, false |];    % M2: Inspection + Revision

MPeriode = [| 7200, 14400       % TER: M1 tous les 5j, M2 tous les 10j
           | 10080, 20160 |];   % TGV: M1 tous les 7j, M2 tous les 14j

MDerniereFois = [| -5000, -10000    % T1
                | -6000, -12000     % T2
                | -4000, -8000      % T3
                | -7000, -15000     % T4
                | -8000, -16000 |]; % T5
