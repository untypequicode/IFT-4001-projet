% === Voies ===
VNb = [3, 3, 2];        % 3 extérieures + 3 ateliers + 2 lavages
V = [V01, V02, V03, V04, V05, V06, V07, V08];
VDuplex = [Simple, Duplex, Simple];

% === Équipements ===
