% === Techniciens (shifts) ===
SDivision = 3;          % 3 shifts par jour (8h chacun)
SDCalibration = 360;    % Début à 6h

SCapacite = [| 3, 2, 2      % Division 1 (matin): 3 méca, 2 élec, 2 tech
             | 3, 2, 2      % Division 2 (après-midi)
             | 2, 1, 1 |];  % Division 3 (nuit): effectif réduit

