VType = {V_Atelier, V_Garage}; VId = {V1, V2, V3};
EType = {Pont_Elevateur}; MType = {M_Prev_Courte};
OType = {Op_Check, Op_Nettoyage}; SType = {Mecano, Elec};
GType = {Gare_Centrale}; Plexite = {Simple, Double};

TNb = [1, 1]; T = [Train_A, Train_B]; TDuplex = [Simple, Double];
VNb = [1, 2]; V = [V1, V2, V3]; VDuplex = [Simple, Double];
ECapacite = [1]; EQuantite = [1];

SDivision = 3; SDCalibration = 0;
