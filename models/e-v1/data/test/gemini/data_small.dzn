STempsMax = [| 480, 480 | 480, 480 | 480, 480 |];

GTemps = [10]; GPeriode = 1440;
GTrajetGare = array2d(1..2, 1..24, [Gare_Centrale | i in 1..48]);

% Utilisation de array2d pour éviter les erreurs de dimension
GTrajetSens = array2d(1..2, 1..24, [
  % Train A (24 éléments)
  gare, gare, gare, gare, gare, gare, gare, gare,
  aller, aller, aller, aller, aller, aller, aller, aller,
  retour, retour, gare, gare, gare, gare, gare, gare,
  % Train B (24 éléments)
  gare, gare, gare, gare, 
  aller, aller, aller, aller, aller, aller, aller, aller,
  retour, retour, retour, retour, retour, retour, retour, retour,
  gare, gare, gare, gare
]);

OEquipement = [| true | false |]; 
OTemps = [| 60, 60 | 30, 60 |];
ODependance = [| false, true | false, false |];
OShift = [1, 1]; OVType = [V_Atelier, V_Garage];
MOperation = [| true, true |];
MPeriode = [| 1440 | 1440 |]; MDerniereFois = [| -1000 | -1000 |];