% =========================================================
% DATA_MEDIUM.DZN (CORRIGÉ V4)
% =========================================================

H = 2880; P = 60;
Setup = 15; Deplacement = 15; Nettoyage = 30; Preparation = 45; Transfert = 20;

TType = {TER, TGV}; 
TId = {TER_01, TER_02, TGV_01, TGV_02};
VType = {V_Maint_Lourde, V_Rapide}; 
VId = {V_L1, V_L2, V_R1, V_R2, V_R3};
EType = {Grue, Banc_Essai}; 
MType = {M_Preventive, M_Urgence};
OType = {Op_Meca_Lourde, Op_Diag_Elec, Op_Visite}; 
SType = {Mecano, Electricien};
GType = {Gare_Nord, Gare_Sud}; 
Plexite = {Simple, Double};

TNb = [2, 2]; 
T = [TER_01, TER_02, TGV_01, TGV_02];
TDuplex = [Simple, Double]; 

VNb = [2, 3]; 
V = [V_L1, V_L2, V_R1, V_R2, V_R3];
VDuplex = [Double, Simple]; 

ECapacite = [1, 2]; EQuantite = [1, 2];

% 4 divisions par jour = shifts de 6h (360 min)
SDivision = 4; 
SDCalibration = 0;

SCapacite = [| 2, 1 | 1, 0 | 2, 2 | 1, 1 |]; 

% CORRECTION : 0 autorisé (assurez-vous d'avoir modifié constant.mzn comme indiqué précédemment)
STempsMin = array2d(1..4, SType, [0 | i in 1..8]);

% CORRECTION ICI : Max 360 car 1440 / 4 = 360. 
% On ne peut pas travailler 720 min dans un créneau de 360 min.
STempsMax = array2d(1..4, SType, [360 | i in 1..8]);

GTemps = [15, 20]; GPeriode = 1440; 
GTrajetGare = array2d(1..4, 1..24, [if i mod 2 == 0 then Gare_Nord else Gare_Sud endif | i in 1..96]);

GTrajetSens = array2d(1..4, 1..24, [
  % TER_01
  gare, gare, gare, gare, gare, gare, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, retour, retour, gare, gare,
  % TER_02
  aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, gare, gare, gare, gare, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller,
  % TGV_01
  gare, gare, gare, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, gare,
  % TGV_02
  gare, gare, gare, gare, gare, gare, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, aller, gare, gare
]);

OEquipement = [| true, false | false, true | false, false |];
OTemps = [| 120, 180 | 60, 60 | 30, 45 |];
ODependance = [| false, false, false | true, false, false | false, false, false |];
OShift = [2, 1, 1]; OVType = [V_Maint_Lourde, V_Maint_Lourde, V_Rapide];
MOperation = [| false, false, true | true, true, false |];
MPeriode = [| 2880, 5000 | 2880, 5000 |]; 
MDerniereFois = [| 0, -100 | -100, 0 | 0, 0 | -2000, -2000 |];