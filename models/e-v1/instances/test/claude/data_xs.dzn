% ============================================================================
% Jeu de données XS (Extra Small) - Test minimal
% 2 trains, 2 voies, 1 jour d'horizon
% ============================================================================

% === Horizon et unités ===
H = 1440;               % 1 jour (24h * 60min)
P = 60;                 % Période de 1 heure
Setup = 15;             % 15 min setup
Deplacement = 5;        % 5 min déplacement
Nettoyage = 30;         % 30 min nettoyage
Preparation = 20;       % 20 min préparation
Transfert = 45;         % 45 min transfert

% === Types énumérés ===
TType = {TER};
TId = {T1, T2};
VType = {Atelier};
VId = {V1, V2};
EType = {Moteur};
MType = {M1};
OType = {Inspection};
SType = {Mecanicien};
GType = {Centre, Terminus};
Plexite = {Simple};

% === Trains ===
TNb = [2];              % 2 trains TER
T = [T1, T2];
TDuplex = [Simple];

% === Voies ===
VNb = [2];              % 2 voies atelier
V = [V1, V2];
VDuplex = [Simple];

% === Équipements ===
ECapacite = [1];        % 1 utilisation par équipement
EQuantite = [2];        % 2 équipements moteur

% === Techniciens (shifts) ===
SDivision = 2;          % 2 shifts par jour
SDCalibration = 360;    % Début à 6h

SCapacite = [| 1        % Division 1: 1 mécanicien
             | 1 |];    % Division 2: 1 mécanicien

STempsMin = [| 240      % Min 4h de travail
            | 240 |];

STempsMax = [| 480      % Max 8h de travail
            | 480 |];

% === Trajets & Gares ===
GTemps = [0, 30];       % Centre: 0min, Terminus: 30min
GPeriode = 1440;        % Période trajet = 1 jour

% Trajets: 2 trains, 24 périodes (GP = H/P = 24)
GTrajetGare = [| Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre
              | Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre, Centre |];

GTrajetSens = [| gare, gare, gare, gare, gare, gare, aller, aller, aller, aller, retour, retour, retour, retour, gare, gare, gare, gare, gare, gare, gare, gare, gare, gare
              | gare, gare, gare, gare, aller, aller, aller, aller, aller, retour, retour, retour, retour, gare, gare, gare, gare, gare, gare, gare, gare, gare, gare, gare |];

% === Maintenances & Opérations ===
OEquipement = [| true |];       % Inspection nécessite Moteur
OTemps = [| 60 |];              % 60 min par inspection (Simple)
ODependance = [| false |];      % Pas de dépendance
OShift = [1];                   % 1 technicien par opération
OVType = [Atelier];             % Voie atelier requise

MOperation = [| true |];        % M1 contient Inspection
MPeriode = [| 10080 |];         % Maintenance tous les 7 jours (TER)

MDerniereFois = [| -5000        % T1: dernière M1 il y a 5000 min
                 | -3000 |];    % T2: dernière M1 il y a 3000 min
