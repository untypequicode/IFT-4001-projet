% === DATA XS (5 Trains) ===
H = 10080; P = 30;
Setup = 30; Deplacement = 30; Nettoyage = 30; Preparation = 30; Transfert = 30;

TType = {TER, TGV}; 
TId = {TER1, TER2, TER3, TGV1, TGV2};
VType = {V_Ext, V_Int}; 
VId = {V1, V2, V3, V4, V5, V6};
EType = {Pont}; 
MType = {M_Check};
OType = {Op_Meca, Op_Elec}; 
SType = {TechMeca, TechElec};
GType = {Gare1}; Plexite = {Simple, Double};

TNb = [3, 2]; T = [TER1, TER2, TER3, TGV1, TGV2];
TDuplex = [Simple, Double]; % Par type

VNb = [4, 2]; V = [V1, V2, V3, V4, V5, V6];
VDuplex = [Simple, Double]; % Par type

ECapacite = [2]; EQuantite = [2];

% 3 Shifts de 8h (480min)
SDivision = 3; SDCalibration = 0;
SCapacite = [| 2, 1 | 2, 1 | 1, 1 |]; % Moins de staff la nuit (Shift 3)
STempsMin = array2d(1..3, SType, [0, 0, 0, 0, 0, 0]);
STempsMax = array2d(1..3, SType, [480, 480, 480, 480, 480, 480]);

GTemps = [30]; GPeriode = 10080; 
% GP = 10080 / 30 = 336 périodes
GTrajetGare = array2d(1..5, 1..336, [Gare1 | t in 1..5, p in 1..336]);

% Cycle journalier simple sur 7 jours (48 périodes par jour)
GTrajetSens = array2d(1..5, 1..336, [
  let { int: h = p mod 48 } in 
  if h >= 12 /\ h <= 40 then aller 
  elseif h > 40 /\ h <= 42 then retour 
  else gare endif
  | t in 1..5, p in 1..336
]);

OEquipement = [| false | true |];
OTemps = [| 60, 90 | 60, 120 |];
ODependance = [| false, true | false, false |];
OShift = [1, 1]; OVType = [V_Ext, V_Int];

MOperation = [| true, true |];
MPeriode = [| 10080 | 10080 |]; % Hebdomadaire
MDerniereFois = [| -500 | -100 | -5000 | 0 | -2000 |];