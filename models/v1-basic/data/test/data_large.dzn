% =====================================================================
% DONNÉES FICTIVES - Système de maintenance ferroviaire
% =====================================================================

% =====================================================================
% Horizon et unités
% =====================================================================
H = 10080;                    % 1 semaine (7 jours * 24h * 60min)
P = 30;                       % Périodes de 30 minutes
Setup = 15;                   % 15 minutes de setup
Deplacement = 10;             % 10 minutes de déplacement
Nettoyage = 45;               % 45 minutes de nettoyage
Preparation = 60;             % 1 heure de préparation
Transfert = 20;               % 20 minutes de transfert

Plexite = {Simple, Double};   % Trains simples ou à double étage

% =====================================================================
% Trains
% =====================================================================
TType = {TER, Intercite, TGV};
TId = {T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12};

TNb = [5, 4, 3];              % 5 TER, 4 Intercités, 3 TGV
T = [T1, T2, T3, T4, T5,      % TER
     T6, T7, T8, T9,          % Intercités
     T10, T11, T12];          % TGV

TDuplex = [Simple,            % TER: simple
           Simple,            % Intercité: simple
           Double];           % TGV: double étage

% =====================================================================
% Voies
% =====================================================================
VType = {VoieNettoyage, VoieReparation, VoieRevision, VoieStationnement};
VId = {V1, V2, V3, V4, V5, V6, V7, V8, V9, V10};

VNb = [2, 3, 2, 3];           % 2 voies nettoyage, 3 réparation, 2 révision, 3 stationnement
V = [V1, V2,                  % Nettoyage
     V3, V4, V5,              % Réparation
     V6, V7,                  % Révision
     V8, V9, V10];            % Stationnement

VDuplex = [Simple,            % Voie nettoyage: trains simples
           Simple,            % Voie réparation: trains simples
           Double,            % Voie révision: tous types
           Double];           % Voie stationnement: tous types

% =====================================================================
% Équipements
% =====================================================================
EType = {Pont_elevateur, Compresseur, Poste_soudure, Chariot_outils};

ECapacite = [2, 3, 1, 4];     % Capacité par type d'équipement
EQuantite = [3, 4, 2, 6];     % Nombre d'équipements disponibles

% =====================================================================
% Shifts (3 équipes: matin, après-midi, nuit)
% =====================================================================
SType = {Mecanicien, Electricien, Agent_nettoyage};
SDivision = 3;
SDCalibration = 360;          % Début à 6h du matin

% Capacités par shift (matin, après-midi, nuit)
SCapacite = [| 8, 6, 4 |      % Matin: 8 mécaniciens, 6 électriciens, 4 agents
               6, 5, 3 |      % Après-midi: 6, 5, 3
               3, 3, 2 |];    % Nuit: 3, 3, 2

% Temps min/max par shift (en minutes)
STempsMin = [| 180, 180, 120 |  % Matin
               180, 180, 120 |  % Après-midi
               120, 120, 90 |]; % Nuit

STempsMax = [| 420, 420, 360 |  % Matin
               420, 420, 360 |  % Après-midi
               300, 300, 240 |]; % Nuit

