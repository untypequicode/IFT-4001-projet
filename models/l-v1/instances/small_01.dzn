% Instance générée automatiquement
% 2 trains, 4 maintenances, 8 opérations

H = 1440;

TRAIN = 1..2;
MAINT = 1..4;
OP = 1..8;
TRACK = 1..3;
TECH = 1..2;
EQUIP = 1..2;

% Trains
arrival = [0, 360];
departure = [480, 1080];
train_complexity = [2, 3];

% Maintenances
maint_train = [1, 1, 2, 2];
priority = [2, 2, 1, 1];
due_date = [400, 450, 720, 1000];
periodicity = [90, 60, 60, 90];
last_done = [0, 0, 0, 0];

% Opérations
op_maint = [1, 1, 2, 2, 3, 3, 4, 4];
duration = [98, 69, 39, 90, 75, 70, 100, 86];
required_track_type = [1, 1, 2, 1, 2, 1, 2, 2];
predecessor = [0, 1, 0, 3, 0, 5, 0, 7];

% Techniciens
nb_total = [3, 7];
min_time = [231, 238];
max_time = [477, 361];

% Équipements
quantity = [6, 15];
simultaneous_capacity = [5, 2];

% Relations opération-technicien
tech_required = array2d(OP, TECH, [
    3, 2, 2, 0, 1, 1, 3, 0, 3, 0, 2, 0, 1, 2, 3, 2
]);

% Relations opération-équipement
equip_required = array2d(OP, EQUIP, [
    0, 2, 0, 2, 0, 2, 0, 1, 1, 2, 2, 1, 1, 0, 2, 0
]);

% Équipement disponible sur voie
equip_available_on_track = array2d(TRACK, EQUIP, [
    true, false, true, true, true, true
]);

% Setup
setup_time_between_trains = 30;
setup_time_between_ops = 10;
