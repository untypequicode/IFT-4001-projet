% ============================================================================
% Fichier de données d'exemple pour le modèle de planification ferroviaire
% ============================================================================

% Horizon temporel : 24 heures = 1440 minutes
H = 1440;

% ----------------------------------------------------------------------------
% ENSEMBLES
% ----------------------------------------------------------------------------
TRAIN = 1..3;      % 3 trains
MAINT = 1..5;      % 5 maintenances au total
OP = 1..8;         % 8 opérations au total
TRACK = 1..4;      % 4 voies disponibles
TECH = 1..3;       % 3 types de techniciens (mécanique, électricité, confort)
EQUIP = 1..2;      % 2 types d'équipements

% ----------------------------------------------------------------------------
% TRAINS
% ----------------------------------------------------------------------------
% Train 1: Arrive à 0h (début), part à 8h (480 min)
% Train 2: Arrive à 6h (360 min), part à 18h (1080 min)
% Train 3: Arrive à 12h (720 min), part à 24h (1440 min)
arrival = [0, 360, 720];
departure = [480, 1080, 1440];
train_complexity = [1, 2, 1];

% ----------------------------------------------------------------------------
% MAINTENANCES
% ----------------------------------------------------------------------------
% Relation maintenance → train
% Maintenance 1,2 → Train 1
% Maintenance 3,4 → Train 2
% Maintenance 5 → Train 3
maint_train = [1, 1, 2, 2, 3];

% Périodicité (en jours, pour information)
periodicity = [30, 90, 30, 180, 60];

% Priorité: 1 = urgente, 2 = préventive
priority = [1, 2, 1, 2, 2];

% Dernière fois effectuée (en jours depuis référence)
last_done = [0, 0, 0, 0, 0];

% Dates butoirs idéales (en minutes depuis le début de l'horizon)
% Pour les urgentes, on veut les faire tôt
% Pour les préventives, on peut être plus flexible
due_date = [240, 400, 720, 1000, 1200];

% ----------------------------------------------------------------------------
% OPÉRATIONS
% ----------------------------------------------------------------------------
% Relation opération → maintenance
% Maintenance 1 a 2 opérations (1, 2)
% Maintenance 2 a 1 opération (3)
% Maintenance 3 a 2 opérations (4, 5)
% Maintenance 4 a 2 opérations (6, 7)
% Maintenance 5 a 1 opération (8)
op_maint = [1, 1, 2, 3, 3, 4, 4, 5];

% Durée des opérations (en minutes)
duration = [60, 90, 120, 45, 75, 90, 60, 100];

% Type de voie requise (1 = standard, 2 = avec alimentation électrique, etc.)
required_track_type = [1, 1, 2, 1, 1, 2, 1, 1];

% Prédécesseurs (0 = pas de prédécesseur)
% Opération 2 doit venir après opération 1
% Opération 5 doit venir après opération 4
% Opération 7 doit venir après opération 6
predecessor = [0, 1, 0, 0, 4, 0, 6, 0];

% ----------------------------------------------------------------------------
% TECHNICIENS
% ----------------------------------------------------------------------------
% Type 1: Mécaniciens (5 disponibles)
% Type 2: Électriciens (3 disponibles)
% Type 3: Confort (2 disponibles)
nb_total = [5, 3, 2];

% Temps minimum de travail par technicien (en minutes)
min_time = [240, 180, 120];

% Temps maximum de travail par technicien (en minutes)
max_time = [480, 420, 360];

% ----------------------------------------------------------------------------
% ÉQUIPEMENTS
% ----------------------------------------------------------------------------
% Équipement 1: Outils spéciaux (quantité totale: 10, capacité simultanée: 5)
% Équipement 2: Bancs de test (quantité totale: 4, capacité simultanée: 2)
quantity = [10, 4];
simultaneous_capacity = [5, 2];

% ----------------------------------------------------------------------------
% RELATIONS OPÉRATION - TECHNICIEN
% ----------------------------------------------------------------------------
% tech_required[op, tech] = nombre de techniciens de type 'tech' requis pour 'op'
% Format: array2d(OP, TECH, [liste plate par ligne])
tech_required = array2d(OP, TECH, [
    % Op 1: 2 mécaniciens, 0 électriciens, 0 confort
    2, 0, 0,
    % Op 2: 1 mécanicien, 1 électricien, 0 confort
    1, 1, 0,
    % Op 3: 3 mécaniciens, 0 électriciens, 1 confort
    3, 0, 1,
    % Op 4: 0 mécaniciens, 2 électriciens, 0 confort
    0, 2, 0,
    % Op 5: 1 mécanicien, 1 électricien, 0 confort
    1, 1, 0,
    % Op 6: 2 mécaniciens, 0 électriciens, 0 confort
    2, 0, 0,
    % Op 7: 1 mécanicien, 0 électriciens, 1 confort
    1, 0, 1,
    % Op 8: 2 mécaniciens, 1 électricien, 0 confort
    2, 1, 0
]);

% ----------------------------------------------------------------------------
% RELATIONS OPÉRATION - ÉQUIPEMENT
% ----------------------------------------------------------------------------
% equip_required[op, equip] = quantité d'équipement 'equip' requis pour 'op'
% Format: array2d(OP, EQUIP, [liste plate par ligne])
equip_required = array2d(OP, EQUIP, [
    % Op 1: 2 outils spéciaux, 0 bancs de test
    2, 0,
    % Op 2: 1 outil spécial, 0 bancs
    1, 0,
    % Op 3: 3 outils spéciaux, 1 banc de test
    3, 1,
    % Op 4: 0 outils, 1 banc de test
    0, 1,
    % Op 5: 1 outil spécial, 0 bancs
    1, 0,
    % Op 6: 2 outils spéciaux, 0 bancs
    2, 0,
    % Op 7: 1 outil spécial, 0 bancs
    1, 0,
    % Op 8: 2 outils spéciaux, 1 banc de test
    2, 1
]);

% ----------------------------------------------------------------------------
% RELATIONS VOIE - ÉQUIPEMENT
% ----------------------------------------------------------------------------
% equip_available_on_track[track, equip] = true si l'équipement est disponible sur la voie
% Voies 1-2: standard (outils seulement)
% Voies 3-4: avec alimentation électrique (outils + bancs de test)
% Format: array2d(TRACK, EQUIP, [liste plate par ligne])
equip_available_on_track = array2d(TRACK, EQUIP, [
    % Voie 1: outils oui, bancs non
    true, false,
    % Voie 2: outils oui, bancs non
    true, false,
    % Voie 3: outils oui, bancs oui
    true, true,
    % Voie 4: outils oui, bancs oui
    true, true
]);

% ----------------------------------------------------------------------------
% PARAMÈTRES DE SETUP
% ----------------------------------------------------------------------------
setup_time_between_trains = 30;  % 30 minutes entre deux trains sur même voie
setup_time_between_ops = 10;     % 10 minutes entre opérations


